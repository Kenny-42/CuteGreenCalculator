<UserControl x:Class="CuteGreenCalculator.Controls.CalculatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             Focusable="True"
             FocusVisualStyle="{x:Null}"
             d:DesignHeight="840" d:DesignWidth="496">

    <!--
        The calculator body art (background.png) is native 62x105 px, rendered
        here at an 8x integer scale (496x840) with nearest-neighbor sampling so
        the pixel art stays crisp. This control owns all calculator face layout;
        it must not depend on anything window-chrome related (title, resize
        mode, etc.) so a future custom borderless window frame can host it
        unchanged.

        No calculator logic is wired up here yet (see add-calculator-engine) -
        DisplayText shows a static placeholder and buttons have no Click
        handlers.

        The Grid below stays fixed at its native 496x840 "design" size; the
        Viewbox wrapping it scales the whole rendered face as one unit to
        fill whatever size MainWindow currently is (see add-resizable-window).
        MainWindow locks the window's aspect ratio during resize, so this
        Viewbox only ever scales uniformly - it never needs to letterbox.
    -->
    <Viewbox Stretch="Uniform">
    <Grid Width="496" Height="840">

        <Image Source="pack://application:,,,/Assets/background.png"
               Stretch="Fill"
               RenderOptions.BitmapScalingMode="NearestNeighbor" />

        <!--
            Always-on-top toggle. See AlwaysOnTopToggleStyle in
            PixelButtonStyles.xaml for a note on its TEMPORARY placeholder
            art (issue #5).
        -->
        <ToggleButton x:Name="BtnAlwaysOnTop"
                      Style="{StaticResource AlwaysOnTopToggleStyle}"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      Margin="0,12,12,0"
                      ToolTip="Keep window on top"
                      AutomationProperties.Name="Always on top toggle" />

        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Status row: face display + heart display -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <Grid Width="120" Height="80" Margin="0,0,8,0">
                    <Image Source="pack://application:,,,/Assets/face_screen.png"
                           Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <Image x:Name="FaceImage"
                           Source="pack://application:,,,/Assets/face.png"
                           Width="72" Height="48"
                           Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Grid>
                <Grid Width="280" Height="80">
                    <Image Source="pack://application:,,,/Assets/heart_screen.png"
                           Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/heart.png" Width="56" Height="48"
                               Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <Image Source="pack://application:,,,/Assets/heart.png" Width="56" Height="48"
                               Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <Image Source="pack://application:,,,/Assets/heart.png" Width="56" Height="48"
                               Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <Image Source="pack://application:,,,/Assets/heart.png" Width="56" Height="48"
                               Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <!--
                Output screen. DisplayText is a real editable TextBox (issue
                #17): the user can click into it, move the cursor, select
                text, and edit the expression directly. Its font size is
                auto-shrunk in code-behind (see AutoSizeDisplayFont) rather
                than clipped/ellipsized, so Padding here only needs to keep
                text clear of the copy button in the top-left corner.
                Character filtering, caret-aware insertion, and native
                Backspace/Delete/Cut resyncing all live in the code-behind.
            -->
            <Grid Grid.Row="1" Width="432" Height="104" Margin="0,0,0,16">
                <Image Source="pack://application:,,,/Assets/output_screen.png"
                       Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                <TextBox x:Name="DisplayText"
                         Text="0"
                         FontFamily="{StaticResource PixelFont}"
                         FontSize="32"
                         Foreground="#3E5C3B"
                         CaretBrush="#3E5C3B"
                         SelectionBrush="#663E5C3B"
                         Background="Transparent"
                         BorderThickness="0"
                         TextAlignment="Right"
                         VerticalContentAlignment="Center"
                         Padding="64,0,20,0"
                         FocusVisualStyle="{x:Null}">
                    <TextBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="CopyMenuItem" Header="Copy" />
                            <MenuItem x:Name="PasteMenuItem" Header="Paste" />
                        </ContextMenu>
                    </TextBox.ContextMenu>
                </TextBox>
                <Button x:Name="BtnCopyDisplay"
                        Style="{StaticResource CopyIconButtonStyle}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="18,18,0,0"
                        ToolTip="Copy"
                        AutomationProperties.Name="Copy display" />
            </Grid>

            <!-- Speed-dial row -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="Btn45" Content="45" Style="{StaticResource MidGreenButtonStyle}" Margin="0,0,16,0" />
                <Button x:Name="Btn90" Content="90" Style="{StaticResource MidGreenButtonStyle}" Margin="0,0,16,0" />
                <Button x:Name="Btn180" Content="180" Style="{StaticResource MidGreenButtonStyle}" Margin="0,0,16,0" />
                <Button x:Name="Btn270" Content="270" Style="{StaticResource MidGreenButtonStyle}" />
            </StackPanel>

            <!-- Row: C CE +/- ÷ -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="BtnClear" Content="C" Style="{StaticResource LightPinkButtonStyle}" Margin="0,0,16,0" />
                <Button x:Name="BtnClearEntry" Content="CE" Style="{StaticResource LightPinkButtonStyle}" Margin="0,0,16,0" />
                <Button x:Name="BtnSign" Content="+/-" Style="{StaticResource LightPinkButtonStyle}" Margin="0,0,16,0" />
                <Button x:Name="BtnDivide" Content="÷" Style="{StaticResource MidPinkButtonStyle}" />
            </StackPanel>

            <!-- Row: 7 8 9 × -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="Btn7" Content="7" Style="{StaticResource LightGreenButtonStyle}" Margin="0,0,16,0" />
                <Button x:Name="Btn8" Content="8" Style="{StaticResource LightGreenButtonStyle}" Margin="0,0,16,0" />
                <Button x:Name="Btn9" Content="9" Style="{StaticResource LightGreenButtonStyle}" Margin="0,0,16,0" />
                <Button x:Name="BtnMultiply" Content="×" Style="{StaticResource MidPinkButtonStyle}" />
            </StackPanel>

            <!-- Row: 4 5 6 − -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="Btn4" Content="4" Style="{StaticResource LightGreenButtonStyle}" Margin="0,0,16,0" />
                <Button x:Name="Btn5" Content="5" Style="{StaticResource LightGreenButtonStyle}" Margin="0,0,16,0" />
                <Button x:Name="Btn6" Content="6" Style="{StaticResource LightGreenButtonStyle}" Margin="0,0,16,0" />
                <Button x:Name="BtnSubtract" Content="−" Style="{StaticResource MidPinkButtonStyle}" />
            </StackPanel>

            <!-- Row: 1 2 3 + -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,0,0,8">
                <Button x:Name="Btn1" Content="1" Style="{StaticResource LightGreenButtonStyle}" Margin="0,0,16,0" />
                <Button x:Name="Btn2" Content="2" Style="{StaticResource LightGreenButtonStyle}" Margin="0,0,16,0" />
                <Button x:Name="Btn3" Content="3" Style="{StaticResource LightGreenButtonStyle}" Margin="0,0,16,0" />
                <Button x:Name="BtnAdd" Content="+" Style="{StaticResource MidPinkButtonStyle}" />
            </StackPanel>

            <!-- Row: 0 . √ = -->
            <StackPanel Grid.Row="7" Orientation="Horizontal">
                <Button x:Name="Btn0" Content="0" Style="{StaticResource LightGreenButtonStyle}" Margin="0,0,16,0" />
                <Button x:Name="BtnDecimal" Content="." Style="{StaticResource LightGreenButtonStyle}" Margin="0,0,16,0" />
                <Button x:Name="BtnSqrt" Content="√" Style="{StaticResource LightPinkButtonStyle}" Margin="0,0,16,0" />
                <Button x:Name="BtnEquals" Content="=" Style="{StaticResource DarkPinkButtonStyle}" />
            </StackPanel>

        </Grid>
    </Grid>
    </Viewbox>
</UserControl>
