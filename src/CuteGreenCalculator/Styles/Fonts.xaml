<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Embedded LCD/seven-segment font (Cursed Timer ULiL, Freeware - see
        https://www.fontspace.com/cursed-timer-ulil-font-f29411) used for
        every button label and the display readout, so the whole app reads
        as one consistent pixel-art typeface.
    -->
    <FontFamily x:Key="PixelFont">pack://application:,,,/CuteGreenCalculator;component/Assets/Fonts/#Cursed Timer ULiL</FontFamily>

</ResourceDictionary>
