<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:CuteGreenCalculator.Styles">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Fonts.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        Shared template for every pixel-art button: the normal art comes from
        Tag (an ImageSource), the pressed art from the PixelButton.PressedSource
        attached property. There is no IsMouseOver trigger, so hovering never
        changes appearance - only IsPressed does, matching the source art
        (which has no hover state).
    -->
    <ControlTemplate x:Key="PixelButtonTemplate" TargetType="Button">
        <Grid Background="Transparent">
            <Image x:Name="PART_Image"
                   Source="{TemplateBinding Tag}"
                   Stretch="Fill"
                   SnapsToDevicePixels="True"
                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                               VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="PART_Image" Property="Source"
                        Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(local:PixelButton.PressedSource)}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Base style: everything skin-independent. Skin styles below inherit from this. -->
    <Style x:Key="PixelButtonBaseStyle" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource PixelButtonTemplate}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{StaticResource PixelFont}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="Foreground" Value="#7B895E" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- 96x80 (12x10 native) skins -->

    <Style x:Key="LightGreenButtonStyle" TargetType="Button" BasedOn="{StaticResource PixelButtonBaseStyle}">
        <Setter Property="Width" Value="96" />
        <Setter Property="Height" Value="80" />
        <Setter Property="Tag">
            <Setter.Value>
                <BitmapImage UriSource="pack://application:,,,/Assets/light_green_button.png" />
            </Setter.Value>
        </Setter>
        <Setter Property="local:PixelButton.PressedSource">
            <Setter.Value>
                <BitmapImage UriSource="pack://application:,,,/Assets/light_green_button_pressed.png" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LightPinkButtonStyle" TargetType="Button" BasedOn="{StaticResource PixelButtonBaseStyle}">
        <Setter Property="Width" Value="96" />
        <Setter Property="Height" Value="80" />
        <Setter Property="Tag">
            <Setter.Value>
                <BitmapImage UriSource="pack://application:,,,/Assets/light_pink_button.png" />
            </Setter.Value>
        </Setter>
        <Setter Property="local:PixelButton.PressedSource">
            <Setter.Value>
                <BitmapImage UriSource="pack://application:,,,/Assets/light_pink_button_pressed.png" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MidPinkButtonStyle" TargetType="Button" BasedOn="{StaticResource PixelButtonBaseStyle}">
        <Setter Property="Width" Value="96" />
        <Setter Property="Height" Value="80" />
        <Setter Property="Tag">
            <Setter.Value>
                <BitmapImage UriSource="pack://application:,,,/Assets/mid_pink_button.png" />
            </Setter.Value>
        </Setter>
        <Setter Property="local:PixelButton.PressedSource">
            <Setter.Value>
                <BitmapImage UriSource="pack://application:,,,/Assets/mid_pink_button_pressed.png" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DarkPinkButtonStyle" TargetType="Button" BasedOn="{StaticResource PixelButtonBaseStyle}">
        <Setter Property="Width" Value="96" />
        <Setter Property="Height" Value="80" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Tag">
            <Setter.Value>
                <BitmapImage UriSource="pack://application:,,,/Assets/dark_pink_button.png" />
            </Setter.Value>
        </Setter>
        <Setter Property="local:PixelButton.PressedSource">
            <Setter.Value>
                <BitmapImage UriSource="pack://application:,,,/Assets/dark_pink_button_pressed.png" />
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Template for the always-on-top toggle. Mirrors PixelButtonTemplate but
        swaps art on IsChecked instead of IsPressed, since a ToggleButton's
        "pressed" state is transient while its "checked" state is what needs
        a persistent visual.
    -->
    <ControlTemplate x:Key="PixelToggleButtonTemplate" TargetType="ToggleButton">
        <Grid Background="Transparent">
            <Image x:Name="PART_Image"
                   Source="{TemplateBinding Tag}"
                   Stretch="Fill"
                   SnapsToDevicePixels="True"
                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="PART_Image" Property="Source"
                        Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(local:PixelButton.CheckedSource)}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--
        Always-on-top toggle: pin icon art (issue #19), native 5x7 px
        rendered at the app's standard 8x integer scale (40x56).
    -->
    <Style x:Key="AlwaysOnTopToggleStyle" TargetType="ToggleButton">
        <Setter Property="Template" Value="{StaticResource PixelToggleButtonTemplate}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Tag">
            <Setter.Value>
                <BitmapImage UriSource="pack://application:,,,/Assets/star.png" />
            </Setter.Value>
        </Setter>
        <Setter Property="local:PixelButton.CheckedSource">
            <Setter.Value>
                <BitmapImage UriSource="pack://application:,,,/Assets/star_pressed.png" />
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Heart toggle: native 7x6 art at the app's standard 8x integer scale
        (56x48), matching the size the 4 hearts already rendered at as plain
        Image elements before they became clickable. Shares
        PixelToggleButtonTemplate with the always-on-top pin above - only the
        skin differs. The group threshold logic (click one, it and everything
        to its right toggles on, everything to its left toggles off; click
        the leftmost toggled heart again to clear all four) lives in
        CalculatorView.xaml.cs, not here - this style only knows how to draw
        one heart in its normal/checked state.
    -->
    <Style x:Key="HeartToggleStyle" TargetType="ToggleButton">
        <Setter Property="Template" Value="{StaticResource PixelToggleButtonTemplate}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Tag">
            <Setter.Value>
                <BitmapImage UriSource="pack://application:,,,/Assets/heart.png" />
            </Setter.Value>
        </Setter>
        <Setter Property="local:PixelButton.CheckedSource">
            <Setter.Value>
                <BitmapImage UriSource="pack://application:,,,/Assets/heart_pressed.png" />
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Copy icon button (issue #17): native 4x4 art at the same 8x scale
        used throughout the app, giving a 32x32 button. Sits in the output
        screen's top-left corner and performs the same action as Ctrl+C /
        right-click copy.
    -->
    <Style x:Key="CopyIconButtonStyle" TargetType="Button" BasedOn="{StaticResource PixelButtonBaseStyle}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Tag">
            <Setter.Value>
                <BitmapImage UriSource="pack://application:,,,/Assets/copy_button.png" />
            </Setter.Value>
        </Setter>
        <Setter Property="local:PixelButton.PressedSource">
            <Setter.Value>
                <BitmapImage UriSource="pack://application:,,,/Assets/copy_button_pressed.png" />
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Speed-dial skin (issue #19): uniform 96x80, same native size as
        every number/operator button, so all four speed-dial buttons
        (45/90/180/270) share one width and still align with the output
        screen.
    -->
    <Style x:Key="MidGreenButtonStyle" TargetType="Button" BasedOn="{StaticResource PixelButtonBaseStyle}">
        <Setter Property="Width" Value="96" />
        <Setter Property="Height" Value="80" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="Tag">
            <Setter.Value>
                <BitmapImage UriSource="pack://application:,,,/Assets/mid_green_button.png" />
            </Setter.Value>
        </Setter>
        <Setter Property="local:PixelButton.PressedSource">
            <Setter.Value>
                <BitmapImage UriSource="pack://application:,,,/Assets/mid_green_button_pressed.png" />
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Title bar button skins (issue #16): native 9x7 art at the app's
        standard 8x scale, giving 72x56 buttons. Shares PixelButtonBaseStyle/
        PixelButtonTemplate with every other button in the app - only the
        skin differs.
    -->

    <Style x:Key="LogoButtonStyle" TargetType="Button" BasedOn="{StaticResource PixelButtonBaseStyle}">
        <Setter Property="Width" Value="72" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Tag">
